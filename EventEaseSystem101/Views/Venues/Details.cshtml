@model EventEaseSystem.Models.Venue

@{
    ViewData["Title"] = "Venue Details";
}

<h1>Venue Details</h1>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.VenueName)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.VenueName)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Location)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Location)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Capacity)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Capacity)
        </dd>
        <dt class="col-sm-2">
            Image
        </dt>
        <dd class="col-sm-10">
            <img src="@(Model.ImageUrl ?? "/images/placeholder-venue.jpg")" alt="@Model.VenueName" style="max-width: 300px;" />
        </dd>
    </dl>
</div>

<h3>Upcoming Bookings</h3>
@if (Model.Bookings != null && Model.Bookings.Any())
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Date</th>
                <th>Event</th>
                <th>Customer</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var booking in Model.Bookings)
            {
                <tr>
                    <td>@booking.BookingDate.ToShortDateString()</td>
                    <td>@(booking.Event?.EventName ?? "N/A")</td>
                    <td>@booking.CustomerName</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>No bookings for this venue yet.</p>
}

<div>
    <a asp-action="Edit" asp-route-id="@Model?.VenueId" class="btn btn-warning">Edit</a>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>
