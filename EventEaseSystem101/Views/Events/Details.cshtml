    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model EventEaseSystem.Models.Event

@{
    ViewData["Title"] = "Event Details";
}

<h1>Event Details</h1>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.EventName)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.EventName)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Description)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Description)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.StartDate)
        </dt>
        <dd class="col-sm-10">
            @(Model.StartDate?.ToString("f") ?? "N/A")
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.EndDate)
        </dt>
        <dd class="col-sm-10">
            @(Model.EndDate?.ToString("f") ?? "N/A")
        </dd>
    </dl>
</div>

<h3>Associated Bookings</h3>
@if (Model.Bookings != null && Model.Bookings.Any())
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Date</th>
                <th>Venue</th>
                <th>Customer</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var booking in Model.Bookings)
            {
                <tr>
                    <td>@booking.BookingDate.ToShortDateString()</td>
                    <td>@(booking.Venue?.VenueName ?? "N/A")</td>
                    <td>@booking.CustomerName</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>No bookings for this event yet.</p>
}

<div>
    <a asp-action="Edit" asp-route-id="@Model?.EventId" class="btn btn-warning">Edit</a>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>

