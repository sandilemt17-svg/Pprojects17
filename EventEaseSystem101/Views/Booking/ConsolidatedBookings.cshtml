@model IEnumerable<EventEaseSystem.ViewModels.BookingViewModel>
@{
    ViewData["Title"] = "Consolidated Bookings";
}

<h1>Consolidated Bookings</h1>

<form method="get" class="mb-3">
    <div class="input-group">
        <input type="text" name="searchTerm" class="form-control"
               placeholder="Search by Booking ID or Event Name..."
               value="@ViewBag.SearchTerm" />
        <button type="submit" class="btn btn-primary">Search</button>
        <a asp-action="ConsolidatedBookings" class="btn btn-secondary">Clear</a>
    </div>
</form>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Booking ID</th>
            <th>Event Name</th>
            <th>Venue</th>
            <th>Booking Date</th>
            <th>Customer Name</th>
            <th>Customer Email</th>
            <th>Customer Phone</th>
            <th>Special Requests</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.BookingId</td>
                <td>@item.EventName</td>
                <td>@item.VenueName</td>
                <td>@item.BookingDate.ToString("yyyy-MM-dd")</td>
                <td>@item.CustomerName</td>
                <td>@item.CustomerEmail</td>
                <td>@item.CustomerPhone</td>
                <td>@item.SpecialRequests</td>
            </tr>
        }
    </tbody>
</table>
